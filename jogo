<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
<title>Assaí Run</title>
<style>
  html, body { margin: 0; height: 100%; background: #111827; }
  body { display: flex; flex-direction: column; align-items: center; justify-content: center;
         font-family: "DejaVu Sans Mono", Consolas, monospace; color: #cbd5e1; }
  canvas { width: min(96vw, 960px); height: auto; image-rendering: pixelated;
           border: 4px solid #000; background: #5c94fc; touch-action: manipulation; }
  p { margin: 10px 12px 0; font-size: 13px; text-align: center; }
</style>
</head>
<body>
<canvas id="game"></canvas>
<p>ESPAÇO, ↑ ou toque para pular · desvie dos carrinhos e pegue as moedas</p>
<script>
const ASSETS = {"spr": "data:image/png;base64,", "cart": "data:image/png;base64,", "coin": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAACgAAAALCAYAAAANxs/1AAAAc0lEQVR42mNkYGBgWBHB8J+BAIhYwcBISC1MDTJAVk9IHpt5LDBOSI4NTsetmXIEhY9NLboadPWE5HGZx4Qhc+UPBBMCxKojFuAwj4lhkINRB446cNSBBAALhogOC3E6iVVHLMBhHgsxBS0phTI56vHJAwDCriucuUS7FgAAAABJRU5ErkJggg==", "bg": "data:image/png;base64,", "lights": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAIAAAAAGCAYAAAAL15YOAAAAMklEQVR42mNkoBD8//vgP8MIAIzMCozD0V9MDKNgRIPRBDCaAEbBaAIYBaMJYBSMTAAAQ2MEDKZ8uAwAAAAASUVORK5CYII=", "shelves": "data:image/png;base64,", "signs": "data:image/png;base64,", "floor": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAEAAAABACAIAAAAlC+aJAAAAeUlEQVR42u3ZwQ2AIAwFUDDOwACeHdQFmMGFODuAVw1nF+BKIuH9BZqX9tC08chnGDlLGDzxeWvXAuW6dQAAAAAAAAAAAKCdtfe2uG9JBwAAAAAAAAAAAAD+GddpIwQAAAAAAAAAADAvwH/ACAEAAAAAAAAAAMwL+ADe0BM4hTXhQQAAAABJRU5ErkJggg=="};

(function () {
  const W = 240, H = 162, S = 2, GROUND = 132, GL = 26, SPR_W = 76, SPR_H = 66;
  const cv = document.getElementById('game');
  const ctx = cv.getContext('2d');
  cv.width = W * S; cv.height = H * S;
  ctx.imageSmoothingEnabled = false;

  // ---------- física / dificuldade (ajuste aqui) ----------
  const START_SPEED = 1.7;     // px (baixa resolução) por atualização
  const MAX_SPEED   = 3.0;
  const SPEED_UP    = 0.00035; // aceleração por atualização
  const JUMP_V      = 4.4;     // impulso do pulo
  const GRAVITY     = 0.14;
  const AIR_FRAMES  = 2 * JUMP_V / GRAVITY;

  const IMG = {};
  const names = Object.keys(ASSETS);
  let loaded = 0;
  names.forEach(n => {
    const im = new Image();
    im.onload = () => { IMG[n] = im; if (++loaded === names.length) init(); };
    im.src = ASSETS[n];
  });

  let state, tick, speed, dist, coinsGot, hgt, vy, onGround, jumpBuf, landT, animT;
  let off, carts, coins, sparks, popT, overAt, best = 0;
  try { best = +localStorage.getItem('assai_run_best') || 0; } catch (e) {}

  function reset() {
    state = 'ready'; tick = 0; speed = START_SPEED; dist = 0; coinsGot = 0;
    hgt = 0; vy = 0; onGround = true; jumpBuf = 0; landT = 0; animT = 0; popT = 0;
    off = { shelf: 0, sign: 0, light: 0, floor: 0 };
    carts = []; coins = []; sparks = [];
  }

  function score() { return Math.floor(dist / 12) + coinsGot * 10; }

  function press() {
    if (state === 'ready') { state = 'play'; jumpBuf = 8; }
    else if (state === 'play') { jumpBuf = 8; }
    else if (state === 'over' && performance.now() - overAt > 500) { reset(); state = 'play'; }
  }

  function spawnCart() {
    const x = W + 20;
    carts.push({ x: x, gap: AIR_FRAMES * speed + 100 + Math.random() * 100 });
    const arc = [0, 6, 9, 6, 0];
    for (let j = 0; j < 5; j++) coins.push({ x: x + 4 + 11 * j, y: 76 - arc[j], j: j, got: false });
    // moedas entre carrinhos: baixas (correndo) ou altas (precisa pular)
    if (Math.random() < 0.7) {
      const high = Math.random() < 0.5;
      const gx = x + carts[carts.length - 1].gap * 0.55;
      for (let j = 0; j < 3; j++) coins.push({ x: gx + 12 * j, y: high ? 38 : 100, j: j + 1, got: false });
    }
  }

  function gameOver() {
    state = 'over'; overAt = performance.now();
    if (score() > best) {
      best = score();
      try { localStorage.setItem('assai_run_best', String(best)); } catch (e) {}
    }
  }

  function update() {
    tick++;
    const v = state === 'over' ? 0 : (state === 'play' ? speed : 1.2);
    off.shelf += v * 0.5; off.sign += v * (4 / 6); off.light += v / 3; off.floor += v;
    animT += v * 0.075;
    if (state !== 'play') return;

    speed = Math.min(MAX_SPEED, speed + SPEED_UP);
    dist += speed;

    // pulo
    if (jumpBuf > 0) {
      if (onGround) { vy = JUMP_V; onGround = false; jumpBuf = 0; popT = 22; }
      else jumpBuf--;
    }
    if (!onGround) {
      hgt += vy; vy -= GRAVITY;
      if (hgt <= 0) { hgt = 0; vy = 0; onGround = true; landT = 14; }
    }
    if (landT > 0) landT--;
    if (popT > 0) popT--;

    // carrinhos
    const last = carts[carts.length - 1];
    if (!last || (W + 20) - last.x >= last.gap) spawnCart();
    carts.forEach(c => c.x -= speed);
    carts = carts.filter(c => c.x > -60);
    coins.forEach(c => c.x -= speed);

    // colisão: pés do grupo x carrinho
    const px1 = GL + 32, px2 = GL + 54;
    for (const c of carts) {
      const cx1 = c.x + 10, cx2 = c.x + 38;
      if (px2 > cx1 && px1 < cx2 && hgt < 36) { gameOver(); return; }
    }

    // coleta de moedas
    const feet = GROUND - hgt;
    coins.forEach(c => {
      if (c.got) return;
      if (c.x > GL + 8 && c.x < GL + SPR_W - 6 && c.y > feet - SPR_H + 4 && c.y < feet - 24) {
        c.got = true; coinsGot++; sparks.push({ x: c.x, y: c.y, t: 8 });
      }
    });
    coins = coins.filter(c => !c.got && c.x > -20);
    sparks.forEach(s => s.t--);
    sparks = sparks.filter(s => s.t > 0);
  }

  // ---------- desenho ----------
  function tileX(img, o, P, y) {
    const pw = P * S;
    const x0 = -(((Math.round(o * S)) % pw) + pw) % pw;
    for (let x = x0; x < cv.width; x += pw) ctx.drawImage(img, x, y);
  }

  function text(t, x, y, font, fill, center) {
    ctx.font = font;
    ctx.textAlign = center ? 'center' : 'left';
    ctx.textBaseline = 'top';
    ctx.fillStyle = '#000'; ctx.fillText(t, x + 2, y + 2);
    ctx.fillStyle = fill;   ctx.fillText(t, x, y);
  }

  function draw() {
    ctx.drawImage(IMG.bg, 0, 0);
    tileX(IMG.lights, off.light, 64, 23 * S);
    tileX(IMG.shelves, off.shelf, 96, 0);
    tileX(IMG.signs, off.sign, 128, 0);
    tileX(IMG.floor, off.floor, 32, GROUND * S);

    // moedas
    coins.forEach(c => {
      if (c.x < -10 || c.x > W + 10) return;
      const bob = [0, -1, -2, -1][(Math.floor(tick / 6) + c.j) % 4];
      const k = (Math.floor(tick / 5) + c.j) % 4;
      ctx.drawImage(IMG.coin, k * 10, 0, 10, 11,
        Math.round(c.x - 5) * S, Math.round(c.y + bob - 5) * S, 20, 22);
    });
    sparks.forEach(s => {
      const x = Math.round(s.x) * S, y = Math.round(s.y) * S;
      ctx.fillStyle = '#fcfcfc';
      ctx.fillRect(x - 2, y - 10, 4, 20); ctx.fillRect(x - 10, y - 2, 20, 4);
      ctx.fillStyle = '#fcc43c';
      ctx.fillRect(x - 6, y - 6, 4, 4); ctx.fillRect(x + 2, y - 6, 4, 4);
      ctx.fillRect(x - 6, y + 2, 4, 4); ctx.fillRect(x + 2, y + 2, 4, 4);
    });

    // carrinhos
    const wf = Math.floor(off.floor / 6) % 2;
    carts.forEach(c => {
      if (c.x < -50 || c.x > W) return;
      ctx.drawImage(IMG.cart, wf * 48, 0, 48, 46, Math.round(c.x) * S, (GROUND - 45) * S, 96, 92);
    });

    // sombra
    const sw = Math.floor(SPR_W * 0.7 - hgt * 0.25);
    const sx = GL + 14 + (SPR_W * 0.7 - sw) / 2;
    ctx.fillStyle = '#6b7280';
    ctx.fillRect(Math.round(sx) * S, GROUND * S, sw * S, 2 * S);

    // poeira
    if (onGround && state !== 'over') {
      const burst = landT > 0;
      for (let k = 0; k < (burst ? 6 : 3); k++) {
        const ph = (Math.floor(tick / 4) * 2 + k * 6) % 18;
        const px = GL + 10 - ph + (k % 2) * 2, py = GROUND - 1 - Math.floor(ph / 4);
        const sz = ph < 9 ? 2 : 1;
        ctx.fillStyle = '#9aa0a6'; ctx.fillRect((px - 1) * S, (py - 1) * S, (sz + 2) * S, (sz + 2) * S);
        ctx.fillStyle = k % 2 ? '#ffffff' : '#cfd8dc'; ctx.fillRect(px * S, py * S, sz * S, sz * S);
      }
    }

    // grupo
    const idx = state === 'over' ? 3 : (onGround ? Math.floor(animT) % 8 : 3);
    ctx.drawImage(IMG.spr, idx * SPR_W, 0, SPR_W, SPR_H,
      GL * S, Math.round(GROUND - hgt - SPR_H + 1) * S, SPR_W * S, SPR_H * S);

    // HUD
    const mono = 'bold 15px "DejaVu Sans Mono", Consolas, monospace';
    text('ASSAÍ', 14, 8, mono, '#fcfcfc');
    text('PONTOS ' + String(score()).padStart(5, '0'), 14, 26, mono, '#fcfcfc');
    text('MOEDAS', 356, 8, mono, '#fcfcfc');
    text('x ' + String(coinsGot).padStart(2, '0'), 356, 26, mono, '#fcd838');
    if (popT > 0) text('PULA!', 236, 130 - (22 - popT), 'bold 18px "DejaVu Sans Mono", Consolas, monospace', '#fcd838');

    // telas
    if (state === 'ready') {
      ctx.fillStyle = 'rgba(0,0,0,0.35)'; ctx.fillRect(0, 150, cv.width, 70);
      text('ASSAÍ RUN', cv.width / 2, 156, 'bold 26px "DejaVu Sans Mono", Consolas, monospace', '#fcd838', true);
      text('ESPAÇO / TOQUE PARA JOGAR', cv.width / 2, 192, 'bold 14px "DejaVu Sans Mono", Consolas, monospace', '#fcfcfc', true);
    } else if (state === 'over') {
      ctx.fillStyle = 'rgba(0,0,0,0.55)'; ctx.fillRect(0, 100, cv.width, 130);
      text('FIM DE JOGO', cv.width / 2, 108, 'bold 28px "DejaVu Sans Mono", Consolas, monospace', '#ff5a3c', true);
      text('PONTOS ' + score() + '   RECORDE ' + best, cv.width / 2, 150,
           'bold 15px "DejaVu Sans Mono", Consolas, monospace', '#fcfcfc', true);
      text('ESPAÇO / TOQUE PARA RECOMEÇAR', cv.width / 2, 186,
           'bold 14px "DejaVu Sans Mono", Consolas, monospace', '#fcd838', true);
    }
  }

  // ---------- loop ----------
  function init() {
    reset();
    let last = 0, acc = 0;
    const STEP = 1000 / 60;
    function loop(t) {
      if (!last) last = t;
      acc += Math.min(100, t - last); last = t;
      while (acc >= STEP) { update(); acc -= STEP; }
      draw();
      requestAnimationFrame(loop);
    }
    requestAnimationFrame(loop);
  }

  window.addEventListener('keydown', e => {
    if (e.code === 'Space' || e.code === 'ArrowUp' || e.code === 'KeyW') { e.preventDefault(); if (!e.repeat) press(); }
  });
  cv.addEventListener('pointerdown', e => { e.preventDefault(); press(); });
})();
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>BurgerHub · O melhor hambúrguer da cidade</title>
<meta name="description" content="Ingredientes selecionados, muito sabor e aquele hambúrguer que você já ama.">
<meta name="theme-color" content="#090909">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#090909; --card:#171819; --line:#292929; --orange:#ff8a00; --orange-2:#ffa133;
  --text:#fff; --soft:#eee; --mute:#ccc; --ink:#111;
  --font:Inter,"Helvetica Neue",Arial,system-ui,sans-serif;
  --hdr:60px;
  color-scheme:dark;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
html{scroll-behavior:smooth;scroll-padding-top:calc(var(--hdr) + env(safe-area-inset-top,0px) + 8px);-webkit-text-size-adjust:100%;background:var(--bg)}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--text);font-family:var(--font);line-height:1.4;-webkit-font-smoothing:antialiased;min-height:100vh}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:60}
[hidden]{display:none!important}
img{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;cursor:pointer;border:0;background:none;padding:0}
:focus-visible{outline:2px solid var(--orange);outline-offset:3px;border-radius:6px}
.wrap{width:min(910px,calc(100% - 48px));margin-inline:auto}
.accent{color:var(--orange)}
.ar{width:.95em;height:.95em;flex:none}

/* botões */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.7em;background:var(--orange);color:var(--ink);font-weight:700;font-size:12px;border-radius:999px;transition:background .15s,transform .15s;white-space:nowrap}
.btn:hover{background:var(--orange-2)}
.btn:active{transform:scale(.97)}
.btn--lg{height:41px;padding:0 24px}
.btn--md{height:35px;padding:0 22px;font-size:11px}
.btn--top{height:33px;padding:0 24px;border-radius:9px;font-size:11px;position:relative}

/* topo */
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:50;background:var(--bg);height:var(--hdr)}
.bar{height:100%;display:grid;grid-template-columns:1fr auto 1fr;align-items:center}
.logo{font-weight:700;font-size:19px;letter-spacing:-.2px;justify-self:start}
.logo b{color:var(--orange);font-weight:700}
.nav{display:flex;gap:42px;font-size:12px;font-weight:600}
.nav a{position:relative;padding:6px 0}
.nav a::after{content:"";position:absolute;left:0;bottom:-2px;height:2px;width:0;background:var(--orange);transition:width .2s}
.nav a:hover::after,.nav a.on::after{width:36px}
.top .btn--top{justify-self:end}
.badge{position:absolute;top:-7px;right:-7px;min-width:18px;height:18px;border-radius:9px;background:#fff;color:var(--ink);font-size:10px;font-weight:800;display:grid;place-items:center;padding:0 4px}
.badge[hidden]{display:none}
.burger{display:none;width:40px;height:40px;place-items:center;justify-self:end;margin-right:-8px}
.burger span,.burger span::before,.burger span::after{display:block;width:20px;height:2px;background:#fff;border-radius:2px;position:relative;transition:transform .2s,background .2s}
.burger span::before,.burger span::after{content:"";position:absolute;left:0}
.burger span::before{top:-6px}.burger span::after{top:6px}
.burger[aria-expanded="true"] span{background:transparent}
.burger[aria-expanded="true"] span::before{transform:translateY(6px) rotate(45deg)}
.burger[aria-expanded="true"] span::after{transform:translateY(-6px) rotate(-45deg)}

/* hero */
.hero{position:relative;overflow:hidden;min-height:clamp(341px,31vw,430px);display:flex;align-items:flex-start}
.hero__img{position:absolute;right:0;bottom:0;width:56.5%;height:97.7%;object-fit:cover;object-position:center}
.hero::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#080808 0,rgba(8,8,8,.82) 43%,rgba(8,8,8,.06) 100%);pointer-events:none}
.hero__in{position:relative;z-index:2;padding-top:clamp(40px,4.6vw,64px);padding-bottom:40px}
.hero h1{margin:0;font-weight:800;font-size:clamp(34px,3.92vw,54px);line-height:1.09;letter-spacing:-.025em}
.hero p{margin:14px 0 0;color:var(--soft);font-size:14px;line-height:1.36;max-width:26em}
.hero .btn{margin-top:26px}
.hero__m{display:none}

/* cardápio */
.sec{padding-top:33px}
.sec__head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:21px}
.sec__head h2{margin:0;font-size:24px;font-weight:700;letter-spacing:-.01em}
.more{display:inline-flex;align-items:center;gap:.7em;color:var(--orange);font-size:12px;font-weight:600}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.card{position:relative;display:block;text-align:left;background:var(--card);border-radius:10px;padding:10px 15px 16px;transition:background .15s,transform .15s,box-shadow .15s}
.card:hover{background:#1d1e20;transform:translateY(-2px)}
.card:active{transform:scale(.985)}
.card__img{display:block;aspect-ratio:185/103;border-radius:6px;overflow:hidden;background:#0c0c0c}
.card__img img{width:100%;height:100%;object-fit:cover}
.card__name{display:block;margin-top:14px;font-size:13px;font-weight:600}
.card__price{display:block;margin-top:8px;font-size:14px}
.card__add{position:absolute;top:18px;right:23px;width:28px;height:28px;border-radius:50%;background:var(--orange);color:var(--ink);display:grid;place-items:center;opacity:0;transform:scale(.8);transition:opacity .15s,transform .15s}
.card:hover .card__add,.card:focus-visible .card__add{opacity:1;transform:none}
.card__add svg{width:14px;height:14px}

/* sobre */
.about{padding-top:57px;padding-bottom:32px}
.about__in{display:grid;grid-template-columns:1fr 1fr;align-items:center}
.about__bar{width:42px;height:3px;background:var(--orange);margin-bottom:26px}
.about h2{margin:0 0 10px;font-size:23px;font-weight:700;letter-spacing:-.01em}
.about p{margin:0;color:var(--soft);font-size:13px;line-height:1.4;max-width:24.5em}
.about p+p{margin-top:10px}
.about .btn{margin-top:19px}
.about__ico{justify-self:end;margin-right:8%;width:122px;color:var(--orange)}
.about__ico svg{width:100%;height:auto;overflow:visible}

/* rodapé */
.foot{border-top:1px solid var(--line);padding:30px 0 22px}
.foot__in{display:grid;grid-template-columns:1fr auto 1fr;align-items:start;row-gap:14px}
.foot .logo{font-size:16px}
.foot small{display:block;margin-top:14px;color:var(--mute);font-size:8.5px}
.foot nav{display:flex;gap:26px;font-size:11px;padding-top:1px}
.foot nav a:hover{color:var(--orange)}
.social{display:flex;gap:16px;justify-self:end;color:#fff}
.social a{width:22px;height:22px;display:grid;place-items:center;transition:color .15s}
.social a:hover{color:var(--orange)}
.social svg{width:19px;height:19px}

/* carrinho */
.scrim{position:fixed;inset:0;background:rgba(0,0,0,.6);opacity:0;pointer-events:none;transition:opacity .2s;z-index:80}
.scrim.on{opacity:1;pointer-events:auto}
.drawer{position:fixed;top:0;right:0;bottom:0;width:min(380px,100%);background:#121314;border-left:1px solid var(--line);z-index:90;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .25s ease;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
.drawer.on{transform:none}
.drawer__head{display:flex;justify-content:space-between;align-items:center;padding:20px 22px;border-bottom:1px solid var(--line)}
.drawer__head h2{margin:0;font-size:18px;font-weight:700}
.x{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;margin-right:-8px}
.x:hover{background:#222}
.drawer__body{flex:1;overflow:auto;padding:8px 22px}
.empty{padding:48px 8px;text-align:center;color:var(--mute);font-size:14px}
.empty svg{width:64px;margin:0 auto 18px;color:var(--orange);opacity:.9}
.item{display:grid;grid-template-columns:64px 1fr auto;gap:12px;align-items:center;padding:14px 0;border-bottom:1px solid #1e1f20}
.item img{width:64px;height:42px;object-fit:cover;border-radius:6px}
.item b{display:block;font-size:13px;font-weight:600}
.item span{font-size:13px;color:var(--mute)}
.qty{display:flex;align-items:center;gap:2px;background:var(--card);border-radius:999px}
.qty button{width:28px;height:28px;border-radius:50%;font-size:16px;line-height:1}
.qty button:hover{background:#262728;color:var(--orange)}
.qty output{min-width:18px;text-align:center;font-size:13px;font-weight:600}
.drawer__foot{padding:18px 22px 22px;border-top:1px solid var(--line)}
.total{display:flex;justify-content:space-between;font-size:15px;margin-bottom:14px}
.total b{font-weight:700}
.drawer__foot .btn{width:100%;height:44px;font-size:13px}
.drawer__foot .btn[disabled]{opacity:.4;pointer-events:none}
.ok{text-align:center;padding:56px 8px}
.ok svg{width:56px;margin:0 auto 18px;color:var(--orange)}
.ok h3{margin:0 0 8px;font-size:20px}
.ok p{margin:0 auto 22px;max-width:24em;color:var(--mute);font-size:14px}
.toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translate(-50%,20px);background:#fff;color:var(--ink);font-size:13px;font-weight:600;padding:11px 18px;border-radius:999px;opacity:0;pointer-events:none;transition:opacity .2s,transform .2s;z-index:100;white-space:nowrap}
.toast.on{opacity:1;transform:translate(-50%,0)}

/* mobile */
@media (max-width:760px){
  .wrap{width:calc(100% - 44px)}
  .bar{grid-template-columns:1fr auto}
  .logo{font-size:20px}
  .burger{display:grid}
  .top .btn--top{display:none}
  .nav{position:fixed;left:0;right:0;top:calc(var(--hdr) + env(safe-area-inset-top,0px));background:var(--bg);flex-direction:column;gap:0;padding:6px 22px 18px;border-bottom:1px solid var(--line);transform:translateY(-8px);opacity:0;visibility:hidden;transition:opacity .2s,transform .2s,visibility .2s;font-size:15px}
  .nav.open{opacity:1;transform:none;visibility:visible}
  .nav a{padding:14px 0;border-bottom:1px solid #1b1b1b}
  .nav a::after{display:none}
  .nav a.on{color:var(--orange)}
  .nav .cta{margin-top:16px;border:0;justify-content:center;height:44px;color:var(--ink);display:flex;align-items:center;font-size:14px}
  .hero{display:block;min-height:0}
  .hero__img,.hero::after{display:none}
  .hero__in{padding-top:20px;padding-bottom:22px}
  .hero h1{font-size:32px;line-height:1.08}
  .hero p{font-size:13.5px;margin-top:14px}
  .hero .btn{height:44px;padding:0 26px;font-size:13px;margin-top:22px}
  .hero__m{display:block;width:100%;height:auto;aspect-ratio:265/143;object-fit:cover}
  .sec{padding-top:26px}
  .sec__head{margin-bottom:18px}
  .sec__head h2{font-size:18px}
  .more{font-size:12px}
  .grid{grid-template-columns:1fr;gap:10px}
  .card{display:grid;grid-template-columns:92px 1fr auto;grid-template-rows:1fr 1fr;column-gap:14px;align-items:center;padding:9px 12px 9px 10px;border-radius:11px}
  .card:hover{transform:none}
  .card__img{grid-row:1/3;width:92px;aspect-ratio:72/47}
  .card__name{margin:0;align-self:end;font-size:13px}
  .card__price{margin:0;align-self:start;font-size:13px}
  .card__add{position:static;grid-column:3;grid-row:1/3;opacity:1;transform:none;background:transparent;border:1.5px solid var(--orange);color:var(--orange);width:28px;height:28px}
  .about{padding-top:34px;padding-bottom:30px}
  .about__in{grid-template-columns:1fr}
  .about__ico{display:none}
  .about__bar{width:34px;margin-bottom:22px}
  .about h2{font-size:20px}
  .about p{font-size:13px;line-height:1.5}
  .about .btn{height:42px;padding:0 26px;font-size:13px;margin-top:20px}
  .foot{padding:26px 0 24px}
  .foot__in{grid-template-columns:1fr auto}
  .foot nav{display:none}
  .foot .logo{font-size:19px}
  .foot small{grid-column:1/-1;font-size:10px;margin-top:0}
  .social{align-self:start}
}
@media (max-width:900px) and (min-width:761px){
  .nav{gap:28px}
  .grid{grid-template-columns:repeat(2,1fr)}
  .about__ico{margin-right:0}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{transition-duration:.01ms!important}
}
</style>
</head>
<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="ar" viewBox="0 0 16 16"><path d="M2 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="burger-ico" viewBox="0 0 122 103"><g fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"><path d="M0 40 C0 14 23 0 61 0 C99 0 122 14 122 40 Z"/><path d="M0 51 H122 L113 67 H9 Z"/><path d="M5 77 Q16 92 28 77 Q40 92 52 77 Q64 92 76 77 Q88 92 100 77 Q112 92 120 77"/><path d="M8 88 H114 Q122 88 122 97 Q122 103 114 103 H8 Q0 103 0 97 Q0 88 8 88 Z"/></g></symbol>
</svg>

<header class="top">
  <div class="wrap bar">
    <a class="logo" href="#inicio" aria-label="BurgerHub, início">Burger<b>Hub</b></a>
    <nav class="nav" id="nav" aria-label="Principal">
      <a href="#inicio" class="on">Início</a>
      <a href="#cardapio">Cardápio</a>
      <a href="#sobre">Sobre</a>
      <a href="#contato">Contato</a>
      <button class="btn cta" type="button" data-cart hidden>Peça agora</button>
    </nav>
    <button class="btn btn--top" type="button" data-cart>Peça agora<span class="badge" data-count hidden>0</span></button>
    <button class="burger" id="burger" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="nav"><span></span></button>
  </div>
</header>

<main>
  <section class="hero" id="inicio">
    <img class="hero__img" src="data:image/jpeg;base64," alt="Hambúrguer com queijo cheddar derretido, alface e tomate sobre tábua de madeira" width="621" height="333">
    <div class="wrap hero__in">
      <h1>O melhor<br><span class="accent">hambúrguer</span><br>da cidade.</h1>
      <p>Ingredientes selecionados, muito sabor<br>e aquele hambúrguer que você já ama.</p>
      <a class="btn btn--lg" href="#cardapio">Ver cardápio <svg class="ar"><use href="#ar"/></svg></a>
    </div>
    <img class="hero__m" src="data:image/jpeg;base64," alt="Hambúrguer com queijo cheddar derretido, alface e tomate" width="265" height="143">
  </section>

  <section class="sec" id="cardapio">
    <div class="wrap">
      <div class="sec__head">
        <h2>Destaques do cardápio</h2>
        <a class="more" href="#cardapio">Ver todos <svg class="ar"><use href="#ar"/></svg></a>
      </div>
      <div class="grid" id="grid"></div>
    </div>
  </section>

  <section class="about" id="sobre">
    <div class="wrap about__in">
      <div>
        <div class="about__bar"></div>
        <h2>Sobre nós</h2>
        <p>Somos apaixonados por hambúrgueres e acreditamos que um bom lanche pode transformar um dia comum em algo especial.</p>
        <p id="more-txt" hidden>Cada hambúrguer é montado na hora, com pão fresquinho, carne suculenta e ingredientes escolhidos a dedo.</p>
        <button class="btn btn--md" type="button" id="more-btn" aria-expanded="false" aria-controls="more-txt"><span>Saiba mais</span> <svg class="ar"><use href="#ar"/></svg></button>
      </div>
      <div class="about__ico" aria-hidden="true"><svg viewBox="-3 -3 128 109"><use href="#burger-ico"/></svg></div>
    </div>
  </section>
</main>

<footer class="foot" id="contato">
  <div class="wrap foot__in">
    <div>
      <a class="logo" href="#inicio">Burger<b>Hub</b></a>
      <small>© 2026 BurgerHub. Todos os direitos reservados.</small>
    </div>
    <nav aria-label="Rodapé">
      <a href="#inicio">Início</a><a href="#cardapio">Cardápio</a><a href="#sobre">Sobre</a><a href="#contato">Contato</a>
    </nav>
    <div class="social">
      <a href="#contato" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9.5"/><circle cx="12" cy="12" r="4.5"/></svg></a>
      <a href="#contato" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.4 21v-7.6h2.6l.4-3h-3V8.5c0-.9.3-1.5 1.5-1.5h1.6V4.3c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H8v3h2.4V21z"/></svg></a>
      <a href="#contato" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9.5"/><circle cx="12" cy="12" r="5" fill="currentColor" stroke="none"/></svg></a>
    </div>
  </div>
</footer>

<div class="scrim" id="scrim"></div>
<aside class="drawer" id="drawer" role="dialog" aria-modal="true" aria-labelledby="dt" aria-hidden="true">
  <div class="drawer__head"><h2 id="dt">Seu pedido</h2><button class="x" type="button" id="close" aria-label="Fechar pedido"><svg width="18" height="18" viewBox="0 0 18 18"><path d="M3 3l12 12M15 3 3 15" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg></button></div>
  <div class="drawer__body" id="dbody"></div>
  <div class="drawer__foot" id="dfoot">
    <div class="total"><span>Total</span><b id="total">R$ 0,00</b></div>
    <button class="btn" type="button" id="checkout" disabled>Finalizar pedido</button>
  </div>
</aside>
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
(function(){
  var PRODUCTS=[
    {id:'classico',name:'Clássico',price:24.9,img:'data:image/jpeg;base64,'},
    {id:'bacon',name:'Bacon Cheddar',price:29.9,img:'data:image/jpeg;base64,'},
    {id:'barbecue',name:'Barbecue',price:27.9,img:'data:image/jpeg;base64,'},
    {id:'batata',name:'Batata Frita',price:12.9,img:'data:image/jpeg;base64,'}
  ];
  var brl=new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'});
  var $=function(s){return document.querySelector(s)};
  var cart={};
  try{cart=JSON.parse(localStorage.getItem('burgerhub_cart')||'{}')||{}}catch(e){cart={}}
  Object.keys(cart).forEach(function(k){if(!PRODUCTS.some(function(p){return p.id===k})||!(cart[k]>0))delete cart[k]});
  function save(){try{localStorage.setItem('burgerhub_cart',JSON.stringify(cart))}catch(e){}}
  function byId(id){return PRODUCTS.filter(function(p){return p.id===id})[0]}
  function count(){return Object.keys(cart).reduce(function(a,k){return a+cart[k]},0)}
  function sum(){return Object.keys(cart).reduce(function(a,k){return a+cart[k]*byId(k).price},0)}

  /* cardápio */
  var plus='<svg viewBox="0 0 14 14"><path d="M7 2v10M2 7h10" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>';
  $('#grid').innerHTML=PRODUCTS.map(function(p){
    return '<button class="card" type="button" data-add="'+p.id+'" aria-label="Adicionar '+p.name+' ao pedido">'+
      '<span class="card__img"><img src="'+p.img+'" alt="'+p.name+'" width="185" height="103"></span>'+
      '<span class="card__name">'+p.name+'</span><span class="card__price">'+brl.format(p.price)+'</span>'+
      '<span class="card__add" aria-hidden="true">'+plus+'</span></button>';
  }).join('');

  /* toast */
  var tt;function toast(msg){var t=$('#toast');t.textContent=msg;t.classList.add('on');clearTimeout(tt);tt=setTimeout(function(){t.classList.remove('on')},1800)}

  /* carrinho */
  var drawer=$('#drawer'),scrim=$('#scrim'),lastFocus=null,done=false;
  function render(){
    var n=count();
    document.querySelectorAll('[data-count]').forEach(function(b){b.textContent=n;b.hidden=!n});
    var body=$('#dbody'),foot=$('#dfoot');
    if(done){
      foot.hidden=true;
      body.innerHTML='<div class="ok"><svg viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><circle cx="28" cy="28" r="24"/><path d="M17 29l8 8 14-17"/></svg><h3>Pedido recebido!</h3><p>Já estamos preparando o seu lanche. Obrigado por escolher a BurgerHub.</p><button class="btn btn--lg" type="button" id="again">Fazer novo pedido</button></div>';
      return;
    }
    foot.hidden=false;
    var keys=Object.keys(cart);
    if(!keys.length){
      body.innerHTML='<div class="empty"><svg viewBox="0 0 122 103" aria-hidden="true"><use href="#burger-ico"/></svg>Seu pedido está vazio.<br>Toque em um lanche do cardápio para adicionar.</div>';
    }else{
      body.innerHTML=keys.map(function(k){var p=byId(k);
        return '<div class="item"><img src="'+p.img+'" alt=""><div><b>'+p.name+'</b><span>'+brl.format(p.price*cart[k])+'</span></div>'+
          '<div class="qty"><button type="button" data-dec="'+k+'" aria-label="Diminuir '+p.name+'">−</button><output>'+cart[k]+'</output><button type="button" data-inc="'+k+'" aria-label="Aumentar '+p.name+'">+</button></div></div>';
      }).join('');
    }
    $('#total').textContent=brl.format(sum());
    $('#checkout').disabled=!keys.length;
  }
  function open(){lastFocus=document.activeElement;done=false;render();drawer.classList.add('on');scrim.classList.add('on');drawer.setAttribute('aria-hidden','false');setTimeout(function(){$('#close').focus()},50);closeMenu()}
  function close(){drawer.classList.remove('on');scrim.classList.remove('on');drawer.setAttribute('aria-hidden','true');if(lastFocus&&lastFocus.focus)lastFocus.focus()}
  function add(id,d){cart[id]=(cart[id]||0)+d;if(cart[id]<=0)delete cart[id];save();render()}

  document.addEventListener('click',function(e){
    var t=e.target.closest('[data-add],[data-inc],[data-dec],[data-cart],#again');if(!t)return;
    if(t.dataset.add){add(t.dataset.add,1);toast(byId(t.dataset.add).name+' adicionado ao pedido')}
    else if(t.dataset.inc)add(t.dataset.inc,1);
    else if(t.dataset.dec)add(t.dataset.dec,-1);
    else if(t.id==='again'){done=false;render()}
    else open();
  });
  $('#close').addEventListener('click',close);
  scrim.addEventListener('click',close);
  $('#checkout').addEventListener('click',function(){if(!count())return;cart={};save();done=true;render()});

  /* menu mobile */
  var burger=$('#burger'),nav=$('#nav');
  function closeMenu(){nav.classList.remove('open');burger.setAttribute('aria-expanded','false');burger.setAttribute('aria-label','Abrir menu')}
  burger.addEventListener('click',function(){
    var o=nav.classList.toggle('open');burger.setAttribute('aria-expanded',o);burger.setAttribute('aria-label',o?'Fechar menu':'Abrir menu');
  });
  nav.addEventListener('click',function(e){if(e.target.closest('a'))closeMenu()});
  var mq=window.matchMedia('(max-width:760px)');
  function syncCta(){var c=$('.nav .cta');c.hidden=!mq.matches}
  syncCta();(mq.addEventListener?mq.addEventListener('change',syncCta):mq.addListener(syncCta));

  document.addEventListener('keydown',function(e){
    if(e.key!=='Escape')return;
    if(drawer.classList.contains('on'))close();else closeMenu();
  });

  /* saiba mais */
  var mb=$('#more-btn'),mt=$('#more-txt');
  mb.addEventListener('click',function(){
    var show=mt.hidden;mt.hidden=!show;mb.setAttribute('aria-expanded',show);
    mb.querySelector('span').textContent=show?'Mostrar menos':'Saiba mais';
  });

  /* link ativo ao rolar */
  var links={};document.querySelectorAll('.nav a').forEach(function(a){links[a.getAttribute('href').slice(1)]=a});
  var ids=['inicio','cardapio','sobre','contato'],forced=null;
  function spy(){
    var y=window.scrollY+window.innerHeight*.4,cur=forced;
    if(!cur){cur='inicio';ids.forEach(function(id){var el=document.getElementById(id);if(el&&el.offsetTop<=y)cur=id})}
    Object.keys(links).forEach(function(k){links[k].classList.toggle('on',k===cur)});
  }
  document.addEventListener('click',function(e){var a=e.target.closest('a[href^="#"]');if(a){forced=a.getAttribute('href').slice(1);if(!links[forced])forced=null;spy()}});
  ['wheel','touchmove','keydown'].forEach(function(ev){window.addEventListener(ev,function(){forced=null},{passive:true})});
  window.addEventListener('scroll',spy,{passive:true});spy();
  render();
})();
</script>
</body>
</html>
